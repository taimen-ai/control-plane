  "typedRequest": {
    "$comment": "Hand-extracted from platform_memory.context.typed.TypedContextRequest.from_payload (the rules the typed route applies to the body); the route also reads scope (ContextIn), allowedNamespaces/allowedScopes (server/app.visibility). where is hand-extracted from memory-service feature/company-knowledge 6841148 (K006, MEM-ADR-020 amendment 2026-09-28 §3): server/domain_schemas.TypedContextIn.where (WhereClause, at most 20) and the value rules of context/where.parse_where; additionalProperties is false on a condition, as a misspelled field would be dropped there.",
    "type": "object",
    "required": [
      "anchors",
      "scope"
    ],
    "properties": {
      "anchors": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "kind": {
                  "type": "string"
                }
              }
            }
          ]
        }
      },
      "traverse": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "relation"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "pattern": "\\S"
            },
            "direction": {
              "enum": [
                "in",
                "out",
                "both"
              ]
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "from": {
              "enum": [
                "anchors",
                "previous"
              ]
            }
          }
        }
      },
      "as_of": {
        "type": "string"
      },
      "allow_semantic": {
        "type": "boolean"
      },
      "scope": {
        "type": "object",
        "required": [
          "namespace"
        ],
        "properties": {
          "namespace": {
            "type": "string"
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "allowedNamespaces": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "allowedScopes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "where": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "required": [
            "attr",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "attr": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "op": {
              "enum": [
                "eq",
                "in",
                "prefix",
                "lte",
                "gte",
                "exists"
              ]
            },
            "value": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "op": {
                    "not": {
                      "const": "exists"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "eq"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "in"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "prefix"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^[^.]+(\\.[^.]+)*$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "lte"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "gte"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "exists"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "boolean"
                  }
                }
              }
            }
          ]
        }
      }
    }
