# control-plane configuration (all variables use the CP_ prefix)

# PostgreSQL connection (SQLAlchemy URL, psycopg3 driver)
CP_DATABASE_URL=postgresql+psycopg://control_plane:control_plane@localhost:5433/control_plane

# One-time bootstrap guard. Unset => POST /api/v1/bootstrap is disabled.
# Generate with: openssl rand -hex 32
CP_BOOTSTRAP_TOKEN=change-me-before-first-run

CP_LOG_LEVEL=INFO

# Lease defaults/bounds in seconds
CP_SESSION_TTL_SECONDS=300
CP_CLAIM_TTL_SECONDS=300

# Idempotency record retention
CP_IDEMPOTENCY_TTL_SECONDS=86400

# CORS is off by default; JSON list of origins to enable, e.g. ["https://app.example.com"]
# CP_CORS_ORIGINS=[]

# --- Optional external Context Memory Engine (v0.4) ---------------------------
# none = fully standalone (default); http = deliver events / build context
# through the HTTP provider below. The provider is never a readiness
# dependency; outage only delays memory, never coordination.
CP_CONTEXT_PROVIDER=none
CP_CONTEXT_BASE_URL=http://localhost:8077
# Credential presented to the Memory Service: auto (default) = the Control Plane's
# IAM service account (CP_IAM_CLIENT_ID/SECRET below, audience memory-service,
# scopes memory:read memory:write memory:tenants memory:service) when configured, else the static
# key; api_key / iam force one of them.
CP_CONTEXT_AUTH=auto
CP_CONTEXT_API_KEY=
CP_CONTEXT_IAM_AUDIENCE=memory-service
CP_CONTEXT_TIMEOUT_SECONDS=3.0
CP_CONTEXT_BATCH_SIZE=100

# --- v0.5 per-tenant delivery isolation (ADR-0036) ----------------------------
# Fairness/rate limits for the Context Adapter cycle. A poison event parks only
# its own tenant; these bound how much work one tenant can take per cycle.
CP_CONTEXT_TENANT_BATCH_SIZE=100
CP_CONTEXT_MAX_TENANTS_PER_CYCLE=20

# --- v0.5 journal retention (ADR-0038) ----------------------------------------
# Minimum age before an operator may archive or prune an event, ON TOP of the
# consumer-cursor and outbox floors. Retention is an explicit operator command
# (POST /api/v1/operations/journal:archive|:prune), never automatic.
CP_JOURNAL_RETENTION_MIN_AGE_SECONDS=2592000

# --- IAM enforcement (IAM-7, ADR-0013 суперпроекта) ---------------------------
# IAM-only режим стенда: CP_IAM_ENABLED=true и CP_LEGACY_API_KEYS_ENABLED=false.
# Issuer — публичный адрес IAM (он же в токенах и в iam_principal_bindings),
# JWKS — внутренний адрес контейнера: проверка подписи не зависит от прокси.
CP_IAM_ENABLED=false
CP_IAM_ISSUER=http://localhost:8010
CP_IAM_JWKS_URL=http://localhost:8010/.well-known/jwks.json
CP_IAM_AUDIENCE=control-plane
CP_IAM_BINDING_CACHE_TTL_SECONDS=30
CP_IAM_BINDING_STALE_AFTER_SECONDS=120
CP_LEGACY_API_KEYS_ENABLED=true

# --- Собственная service identity ядра в IAM (ADR-0013/0030) -------------------
# Service account заводит deploy/bootstrap.py суперпроекта; секрет приходит через
# окружение. Нужен entitlement (check-on-behalf) и Memory Service (CP_CONTEXT_AUTH).
CP_IAM_BASE_URL=http://localhost:8010
CP_IAM_CLIENT_ID=
CP_IAM_CLIENT_SECRET=

# --- Хранилище секретов подключений (CP-ADR-0079 п.1, п.15) --------------------
# OpenBao; ядро входит своим токеном IAM (CP_IAM_CLIENT_ID/SECRET выше, audience
# ниже) через auth/jwt/login под своей ролью. Пустой URL — маршрутам, которым
# хранилище нужно, 503 secret_store_unavailable.
CP_SECRET_STORE_URL=
CP_SECRET_STORE_AUDIENCE=openbao
CP_SECRET_STORE_ROLE=control-plane
# Публичный https-адрес GET /api/v1/connections:callback (буква в букву как у
# провайдера) и страница консоли для возврата браузера; пусто — :authorize 409.
CP_OAUTH_REDIRECT_URI=
CP_CONNECTIONS_RETURN_URL=
CP_OAUTH_STATE_TTL_SECONDS=600
# Период полного прохода воркера connections-policy-sync: политики и роли агентов
# в хранилище, истёкшие ключи подключений.
CP_CONNECTIONS_SYNC_SECONDS=300

# --- Entitlement (ADR-0013), по умолчанию выключен: NullEntitlementClient -----
CP_ENTITLEMENT_ENABLED=false
CP_ENTITLEMENT_BASE_URL=http://localhost:8020

# --- Доменная авторизация (CP-ADR-0055): local | shadow | policy ---------------
# Периметр заморожен (TAI-ADR-0034 п.4, TAI-ADR-0039): policy-service не развивается,
# ядро авторизует локально; shadow/policy — только с experimental-профилем policy.
CP_AUTHZ_MODE=local
