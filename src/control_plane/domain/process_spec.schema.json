{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from $defs.processSpec of the package-sdk catalog schema (schema/v1/object.schema.json): process_schema_from_catalog().",
  "$ref": "#/$defs/processSpec",
  "$defs": {
    "assignChain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/assignee"
      },
      "description": "Candidates in order: the first resolvable one is taken"
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "principal"
          ]
        },
        {
          "required": [
            "role"
          ]
        },
        {
          "required": [
            "agent"
          ]
        },
        {
          "required": [
            "expr"
          ]
        }
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/envOrUuid"
        },
        "role": {
          "$ref": "#/$defs/slug"
        },
        "agent": {
          "$ref": "#/$defs/slug"
        },
        "expr": {
          "$ref": "#/$defs/cel",
          "description": "CEL → principal id, agent:<key> or role:<slug>"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/processStep"
      },
      "description": "Sequence of steps (do block)"
    },
    "cel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "CEL expression in the taimen/1 profile: variables data, event, step, task, instance; cal.* functions; no current time. The core checks types and the cost limit",
      "$comment": "CP-ADR-0075"
    },
    "celMap": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/cel"
      },
      "description": "Path in the instance data → CEL expression"
    },
    "decisionTable": {
      "type": "object",
      "required": [
        "id",
        "hitPolicy",
        "inputs",
        "outputs",
        "rules"
      ],
      "additionalProperties": false,
      "description": "Decision table (DMN in spirit). Condition cell: '-' (any), a literal, a list 'a,b', a range '[a..b)'",
      "properties": {
        "id": {
          "$ref": "#/$defs/processElementId"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "hitPolicy": {
          "enum": [
            "first",
            "unique",
            "collect"
          ]
        },
        "governedBy": {
          "$ref": "#/$defs/governedBy"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id",
              "expr"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/processElementId"
              },
              "expr": {
                "$ref": "#/$defs/cel"
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "date",
                  "timestamp"
                ]
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/processElementId"
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "date",
                  "duration",
                  "object",
                  "array"
                ]
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "when",
              "then"
            ],
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "then": {
                "type": "object"
              },
              "note": {
                "type": "string",
                "maxLength": 500
              },
              "governedBy": {
                "$ref": "#/$defs/governedBy"
              }
            }
          }
        }
      }
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
      "description": "ISO 8601 duration, e.g. P3D, PT4H"
    },
    "durationOrCel": {
      "description": "ISO 8601 duration or a CEL expression yielding a point in time (timestamp) or a duration",
      "oneOf": [
        {
          "$ref": "#/$defs/duration"
        },
        {
          "type": "object",
          "required": [
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/cel"
            }
          }
        }
      ]
    },
    "envOrUuid": {
      "type": "string",
      "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "description": "UUID or an installation ${VARIABLE} (environment topology is not written into the package)"
    },
    "escalation": {
      "type": "object",
      "required": [
        "after",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "after": {
          "oneOf": [
            {
              "const": "due"
            },
            {
              "$ref": "#/$defs/durationOrCel"
            }
          ],
          "description": "due means at the due moment; a duration means after the due"
        },
        "action": {
          "enum": [
            "remind",
            "reassign",
            "notify",
            "raise"
          ]
        },
        "to": {
          "$ref": "#/$defs/assignChain"
        },
        "error": {
          "$ref": "#/$defs/processError"
        }
      }
    },
    "governedBy": {
      "type": "array",
      "maxItems": 20,
      "description": "Knowledge base regulations the element is subject to: the natural key of the memory document and, if needed, a clause",
      "$comment": "TAI-ADR-0054 Р17",
      "items": {
        "type": "object",
        "required": [
          "document"
        ],
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "section": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "jsonSchema": {
      "type": "object",
      "description": "Document JSON Schema (draft 2020-12). The core rejects remote $ref."
    },
    "memoryAnchor": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "case"
          ]
        },
        {
          "required": [
            "key",
            "kind"
          ]
        }
      ],
      "description": "Graph traversal anchor: the instance's case node or an entity by natural key (CEL over data)",
      "properties": {
        "case": {
          "const": true
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "key": {
          "$ref": "#/$defs/cel"
        },
        "via": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "memoryProjection": {
      "type": "object",
      "required": [
        "case"
      ],
      "additionalProperties": false,
      "description": "Projection of the case into the memory graph: delivered by events, only declared fields go into the graph",
      "$comment": "TAI-ADR-0054 Р15",
      "properties": {
        "case": {
          "type": "object",
          "required": [
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "default": "case"
            },
            "key": {
              "$ref": "#/$defs/cel"
            },
            "title": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "facts": {
          "$ref": "#/$defs/celMap",
          "description": "Case fact name → value; a change closes the previous fact with a validity end"
        },
        "entities": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "key",
              "rel"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "key": {
                "$ref": "#/$defs/cel"
              },
              "name": {
                "$ref": "#/$defs/cel"
              },
              "rel": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "when": {
                "$ref": "#/$defs/cel"
              },
              "many": {
                "type": "boolean",
                "description": "key yields a list: one entity per element"
              }
            }
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifacts": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/typeKey"
              }
            }
          }
        }
      }
    },
    "memoryTraverse": {
      "type": "array",
      "maxItems": 10,
      "description": "Traversal steps from the anchors, the same shape as traverse in contextSchema",
      "$comment": "CP-ADR-0064",
      "items": {
        "type": "object",
        "required": [
          "relation"
        ],
        "additionalProperties": false,
        "properties": {
          "relation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "direction": {
            "enum": [
              "in",
              "out",
              "both"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "from": {
            "enum": [
              "anchors",
              "previous"
            ]
          }
        }
      }
    },
    "memoryWhere": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "Filters on node attributes: applied to result nodes and to candidate anchors of semantic expansion; conditions are joined with AND",
      "$comment": "TAI-ADR-0056 Р7, MEM-ADR-020",
      "items": {
        "type": "object",
        "required": [
          "attr",
          "op"
        ],
        "additionalProperties": false,
        "properties": {
          "attr": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "description": "Node attribute name (flat), e.g. okpd2 or validUntil; a list attribute satisfies the condition if any of its elements does",
            "$comment": "MEM-ADR-020"
          },
          "op": {
            "enum": [
              "eq",
              "in",
              "prefix",
              "lte",
              "gte",
              "exists"
            ],
            "description": "prefix compares codes by dot-separated segments: 62.01 matches 62.01.11 but not 62.011; lte/gte are RFC 3339 dates or numbers"
          },
          "value": {
            "description": "CEL expression over the instance data (a string literal goes in CEL quotes: \"'62.01'\"); for in, a CEL list or a list of expressions; for exists, true or false",
            "anyOf": [
              {
                "$ref": "#/$defs/cel"
              },
              {
                "type": [
                  "number",
                  "boolean"
                ]
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "$ref": "#/$defs/cel"
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "not": {
                    "const": "exists"
                  }
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    },
    "processDue": {
      "description": "Due (SLA) of a step or process: an ISO 8601 duration, {at}, a point in time or a duration from data, or exactly one of duration, workdays, workhours with optional calendar and warnBefore",
      "$comment": "CP-ADR-0078 §1",
      "oneOf": [
        {
          "$ref": "#/$defs/durationOrCel"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "duration"
              ]
            },
            {
              "required": [
                "workdays"
              ]
            },
            {
              "required": [
                "workhours"
              ]
            }
          ],
          "properties": {
            "duration": {
              "$ref": "#/$defs/duration"
            },
            "workdays": {
              "$ref": "#/$defs/workdayAmount"
            },
            "workhours": {
              "$ref": "#/$defs/workhourAmount"
            },
            "calendar": {
              "$ref": "#/$defs/typeKey",
              "description": "Calendar of the working units; defaults to the process's spec.calendar"
            },
            "warnBefore": {
              "$ref": "#/$defs/workingSpan",
              "description": "Warning threshold before the due; without it there is no warning"
            }
          }
        }
      ]
    },
    "processElementId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "description": "Stable process element id: the schema layout, migration maps, the journal and the memory graph refer to it. Renaming only via the migrations map"
    },
    "processError": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Error in RFC 7807 form",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "detail": {
          "$ref": "#/$defs/cel"
        }
      }
    },
    "processForm": {
      "type": "object",
      "required": [
        "schema"
      ],
      "additionalProperties": false,
      "description": "Step form: JSON Schema of the data and JSON Forms uischema of the view",
      "properties": {
        "schema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "uischema": {
          "type": "object"
        }
      }
    },
    "processSpec": {
      "type": "object",
      "description": "Process: a case with stages and execution blocks, data by schema, CEL expressions, projection into memory. Executed by the core",
      "$comment": "TAI-ADR-0054, CP-ADR-0074",
      "required": [
        "version",
        "displayName",
        "data",
        "start",
        "stages"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Definition version: a published version is immutable"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^\\$\\{[A-Z][A-Z0-9_]*\\}$"
        },
        "identity": {
          "type": "object",
          "required": [
            "agent"
          ],
          "additionalProperties": false,
          "description": "On whose behalf the process acts: an agent description of kind service or agent",
          "properties": {
            "agent": {
              "$ref": "#/$defs/slug"
            }
          }
        },
        "owner": {
          "$ref": "#/$defs/assignChain",
          "description": "Process owner: tasks about the process are addressed to them (divergence from the regulation, instance errors). Optional; the package check warns if it is missing",
          "$comment": "TAI-ADR-0054 item 5, amendment 2026-09-27"
        },
        "calendar": {
          "$ref": "#/$defs/typeKey",
          "description": "Default calendar for cal.*"
        },
        "due": {
          "$ref": "#/$defs/processDue",
          "description": "Due of the whole process from the instance start",
          "$comment": "CP-ADR-0078 §1"
        },
        "data": {
          "$ref": "#/$defs/jsonSchema",
          "description": "JSON Schema of the instance data; package-sdk expands {$ref: <package file>}"
        },
        "start": {
          "type": "object",
          "required": [
            "on",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "$ref": "#/$defs/processTrigger"
            },
            "key": {
              "$ref": "#/$defs/cel",
              "description": "Instance key: a repeated event with the same key is a correlate, not a new instance"
            },
            "set": {
              "$ref": "#/$defs/celMap"
            }
          }
        },
        "correlate": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "on",
              "key"
            ],
            "additionalProperties": false,
            "properties": {
              "on": {
                "$ref": "#/$defs/processTrigger"
              },
              "key": {
                "$ref": "#/$defs/cel"
              },
              "set": {
                "$ref": "#/$defs/celMap"
              },
              "do": {
                "$ref": "#/$defs/blocks"
              }
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/processStage"
          }
        },
        "onEvent": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "on",
              "do"
            ],
            "additionalProperties": false,
            "properties": {
              "on": {
                "$ref": "#/$defs/processTrigger"
              },
              "do": {
                "$ref": "#/$defs/blocks"
              }
            }
          }
        },
        "timers": {
          "$ref": "#/$defs/processTimers"
        },
        "decisions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/decisionTable"
          }
        },
        "governedBy": {
          "$ref": "#/$defs/governedBy"
        },
        "memory": {
          "$ref": "#/$defs/memoryProjection"
        },
        "retrospective": {
          "type": "object",
          "required": [
            "taskType",
            "assign"
          ],
          "additionalProperties": false,
          "description": "Review of a closed case: the agent proposes lessons, a human confirms",
          "$comment": "TAI-ADR-0054 Р18",
          "properties": {
            "skill": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+$",
              "default": "process.retrospective@1"
            },
            "taskType": {
              "$ref": "#/$defs/typeKey"
            },
            "assign": {
              "$ref": "#/$defs/assignChain"
            },
            "appliesTo": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "description": "Entity kinds lessons are attached to"
            },
            "when": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "migrations": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "policy"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 1
              },
              "to": {
                "type": "integer",
                "minimum": 2
              },
              "policy": {
                "enum": [
                  "pin",
                  "migrate"
                ]
              },
              "map": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/processElementId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/processElementId"
                }
              }
            }
          }
        }
      }
    },
    "processStage": {
      "type": "object",
      "required": [
        "id",
        "steps"
      ],
      "additionalProperties": false,
      "description": "Case stage (CMMN): entry and exit by guards, milestones, required and optional work",
      "properties": {
        "id": {
          "$ref": "#/$defs/processElementId"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "entry": {
          "$ref": "#/$defs/cel",
          "description": "Entry guard; stage.<id>.completed, milestone.<id> and data are available in the expression"
        },
        "exit": {
          "$ref": "#/$defs/cel"
        },
        "repeatable": {
          "type": "boolean"
        },
        "governedBy": {
          "$ref": "#/$defs/governedBy"
        },
        "steps": {
          "$ref": "#/$defs/blocks"
        },
        "discretionary": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/processStep"
          },
          "description": "Work a human adds at their discretion"
        },
        "milestones": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id",
              "when"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/processElementId"
              },
              "when": {
                "$ref": "#/$defs/cel"
              }
            }
          }
        },
        "timers": {
          "$ref": "#/$defs/processTimers"
        }
      }
    },
    "processStep": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "description": "Process step: exactly one kind (human, approve, call, decide, recall, remember, listen, wait, set, raise, compensate, fork, try, do, suspend, resume, complete) plus common fields",
      "oneOf": [
        {
          "required": [
            "human"
          ]
        },
        {
          "required": [
            "approve"
          ]
        },
        {
          "required": [
            "call"
          ]
        },
        {
          "required": [
            "decide"
          ]
        },
        {
          "required": [
            "recall"
          ]
        },
        {
          "required": [
            "remember"
          ]
        },
        {
          "required": [
            "listen"
          ]
        },
        {
          "required": [
            "wait"
          ]
        },
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "raise"
          ]
        },
        {
          "required": [
            "compensate"
          ]
        },
        {
          "required": [
            "fork"
          ]
        },
        {
          "required": [
            "try"
          ]
        },
        {
          "required": [
            "do"
          ]
        },
        {
          "required": [
            "suspend"
          ]
        },
        {
          "required": [
            "resume"
          ]
        },
        {
          "required": [
            "complete"
          ]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/processElementId"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "when": {
          "$ref": "#/$defs/cel",
          "description": "Guard: the step runs only if it is true"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as": {
              "$ref": "#/$defs/celMap"
            }
          },
          "description": "Writing the step result (step.result) into the instance data"
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as": {
              "$ref": "#/$defs/celMap"
            }
          }
        },
        "governedBy": {
          "$ref": "#/$defs/governedBy"
        },
        "onCompensate": {
          "$ref": "#/$defs/blocks",
          "description": "Compensation of a completed step: runs on compensate in reverse order"
        },
        "human": {
          "type": "object",
          "required": [
            "taskType",
            "assign"
          ],
          "additionalProperties": false,
          "properties": {
            "taskType": {
              "$ref": "#/$defs/typeKey"
            },
            "title": {
              "$ref": "#/$defs/cel"
            },
            "customFields": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/cel"
              },
              "description": "Prefill of the created task's fields with case data: a field of the type's fieldSchema → CEL; checked against fieldSchema on publication and on task creation, null leaves the field to the human",
              "$comment": "CP-ADR-0074 §7, amendment 2026-10-01"
            },
            "form": {
              "$ref": "#/$defs/processForm"
            },
            "assign": {
              "$ref": "#/$defs/assignChain"
            },
            "due": {
              "$ref": "#/$defs/processDue"
            },
            "escalations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/escalation"
              }
            },
            "context": {
              "$ref": "#/$defs/stepContext"
            }
          }
        },
        "approve": {
          "type": "object",
          "required": [
            "approvers",
            "quorum"
          ],
          "additionalProperties": false,
          "properties": {
            "taskType": {
              "$ref": "#/$defs/typeKey"
            },
            "approvers": {
              "$ref": "#/$defs/assignChain"
            },
            "mode": {
              "enum": [
                "parallel",
                "sequential"
              ],
              "default": "parallel"
            },
            "quorum": {
              "oneOf": [
                {
                  "enum": [
                    "all",
                    "any"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "atLeast"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "atLeast": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "percent"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "percent": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100
                    }
                  }
                }
              ]
            },
            "earlyDecision": {
              "type": "boolean",
              "default": true
            },
            "separationOfDuties": {
              "$ref": "#/$defs/cel",
              "description": "CEL → list of principals who may not vote; the core checks it at decision time"
            },
            "due": {
              "$ref": "#/$defs/processDue"
            },
            "onDue": {
              "enum": [
                "approve",
                "reject",
                "escalate"
              ]
            },
            "escalations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/escalation"
              }
            },
            "context": {
              "$ref": "#/$defs/stepContext"
            }
          }
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "skill"
              ]
            },
            {
              "required": [
                "agent"
              ]
            },
            {
              "required": [
                "process"
              ]
            }
          ],
          "properties": {
            "skill": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+$"
            },
            "agent": {
              "$ref": "#/$defs/slug"
            },
            "process": {
              "$ref": "#/$defs/typeKey"
            },
            "input": {
              "$ref": "#/$defs/celMap"
            },
            "timeout": {
              "$ref": "#/$defs/durationOrCel"
            },
            "due": {
              "$ref": "#/$defs/processDue"
            },
            "context": {
              "$ref": "#/$defs/stepContext"
            }
          }
        },
        "decide": {
          "type": "object",
          "required": [
            "table"
          ],
          "additionalProperties": false,
          "properties": {
            "table": {
              "$ref": "#/$defs/processElementId"
            },
            "input": {
              "$ref": "#/$defs/celMap"
            }
          }
        },
        "recall": {
          "type": "object",
          "required": [
            "anchors"
          ],
          "additionalProperties": false,
          "description": "Memory query through the core; the answer is a journal event (deterministic replay)",
          "properties": {
            "anchors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/memoryAnchor"
              }
            },
            "traverse": {
              "$ref": "#/$defs/memoryTraverse"
            },
            "query": {
              "$ref": "#/$defs/cel",
              "description": "Semantic expansion text"
            },
            "kinds": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "where": {
              "$ref": "#/$defs/memoryWhere"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "timeout": {
              "$ref": "#/$defs/duration"
            },
            "due": {
              "$ref": "#/$defs/processDue"
            },
            "onTimeout": {
              "$ref": "#/$defs/blocks"
            }
          }
        },
        "remember": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "facts"
              ]
            },
            {
              "required": [
                "entity"
              ]
            }
          ],
          "description": "Write to memory as a core observation from the process identity, with a reference to the case",
          "properties": {
            "entity": {
              "type": "object",
              "required": [
                "kind",
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "key": {
                  "$ref": "#/$defs/cel"
                },
                "name": {
                  "$ref": "#/$defs/cel"
                },
                "text": {
                  "$ref": "#/$defs/cel"
                },
                "links": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "required": [
                      "rel",
                      "kind",
                      "key"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "rel": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "kind": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "key": {
                        "$ref": "#/$defs/cel"
                      }
                    }
                  }
                }
              }
            },
            "facts": {
              "$ref": "#/$defs/celMap",
              "description": "Case fact name → value"
            }
          }
        },
        "listen": {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "description": "Waiting for the first of the events (deferred choice); timeout is a timer",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "on"
                ],
                "additionalProperties": false,
                "properties": {
                  "on": {
                    "$ref": "#/$defs/processTrigger"
                  },
                  "do": {
                    "$ref": "#/$defs/blocks"
                  }
                }
              }
            },
            "timeout": {
              "$ref": "#/$defs/durationOrCel"
            },
            "due": {
              "$ref": "#/$defs/processDue"
            },
            "onTimeout": {
              "$ref": "#/$defs/blocks"
            }
          }
        },
        "wait": {
          "$ref": "#/$defs/durationOrCel",
          "description": "Pause: a duration or a point in time; wait has no due, the pause itself sets the time"
        },
        "set": {
          "$ref": "#/$defs/celMap"
        },
        "raise": {
          "$ref": "#/$defs/processError"
        },
        "compensate": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/processElementId"
              }
            }
          ],
          "description": "Run onCompensate of completed steps in reverse order"
        },
        "fork": {
          "type": "object",
          "required": [
            "branches"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "all",
                "compete"
              ],
              "default": "all"
            },
            "branches": {
              "type": "array",
              "minItems": 2,
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "do"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/processElementId"
                  },
                  "do": {
                    "$ref": "#/$defs/blocks"
                  }
                }
              }
            }
          }
        },
        "try": {
          "type": "object",
          "required": [
            "do"
          ],
          "additionalProperties": false,
          "properties": {
            "do": {
              "$ref": "#/$defs/blocks"
            },
            "retry": {
              "type": "object",
              "required": [
                "limit"
              ],
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "delay": {
                  "$ref": "#/$defs/duration"
                },
                "backoff": {
                  "enum": [
                    "constant",
                    "exponential"
                  ]
                },
                "maxDelay": {
                  "$ref": "#/$defs/duration"
                },
                "on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "description": "Error types to retry; all by default"
                }
              }
            },
            "catch": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "do"
                ],
                "additionalProperties": false,
                "properties": {
                  "errors": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "status": {
                        "type": "integer"
                      }
                    }
                  },
                  "as": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  },
                  "do": {
                    "$ref": "#/$defs/blocks"
                  }
                }
              }
            }
          }
        },
        "do": {
          "$ref": "#/$defs/blocks"
        },
        "suspend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/$defs/cel"
            }
          }
        },
        "complete": {
          "type": "object",
          "required": [
            "outcome"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "processTimers": {
      "type": "array",
      "maxItems": 20,
      "description": "Boundary timers: fire while the stage (process) is open; at from data is recalculated when the data changes",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "do"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/processElementId"
          },
          "at": {
            "$ref": "#/$defs/durationOrCel"
          },
          "interrupting": {
            "type": "boolean",
            "default": false
          },
          "do": {
            "$ref": "#/$defs/blocks"
          }
        }
      }
    },
    "processTrigger": {
      "type": "object",
      "additionalProperties": false,
      "description": "Event source: a core journal event or an observation. where is a CEL filter over event",
      "oneOf": [
        {
          "required": [
            "event"
          ]
        },
        {
          "required": [
            "observation"
          ]
        }
      ],
      "properties": {
        "event": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "observation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "where": {
          "$ref": "#/$defs/cel"
        }
      }
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "stepContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchors"
      ],
      "description": "Context profile of the step executor from memory: explicit relations first, semantic expansion marked inferred",
      "$comment": "TAI-ADR-0054 Р16",
      "properties": {
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/memoryAnchor"
          }
        },
        "traverse": {
          "$ref": "#/$defs/memoryTraverse"
        },
        "semantic": {
          "type": "boolean",
          "description": "Semantic expansion (inferred); true by default"
        },
        "budgetTokens": {
          "type": "integer",
          "minimum": 200,
          "maximum": 32000
        }
      }
    },
    "typeKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Type key: lowercase Latin letters, digits, _ and -"
    },
    "workdayAmount": {
      "oneOf": [
        {
          "$ref": "#/$defs/workdayCount"
        },
        {
          "$ref": "#/$defs/workingAmountExpr"
        }
      ]
    },
    "workdayCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Workdays by the calendar: the same time of day n workdays later (cal.addWorkdays)"
    },
    "workhourAmount": {
      "oneOf": [
        {
          "$ref": "#/$defs/workhourCount"
        },
        {
          "$ref": "#/$defs/workingAmountExpr"
        }
      ]
    },
    "workhourCount": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "description": "Working-time hours by a calendar with working hours (cal.addWorkingTime)"
    },
    "workingAmountExpr": {
      "type": "object",
      "required": [
        "expr"
      ],
      "additionalProperties": false,
      "description": "Number of work units as a CEL expression: a non-negative integer, evaluated once on entering the step (settings.* are the package settings); after that the due date is computed as from a number",
      "$comment": "CP-ADR-0081 Г1",
      "properties": {
        "expr": {
          "$ref": "#/$defs/cel"
        }
      }
    },
    "workingSpan": {
      "description": "Interval: an ISO 8601 duration (astronomical time), {workdays} or {workhours} by the due calendar",
      "oneOf": [
        {
          "$ref": "#/$defs/duration"
        },
        {
          "type": "object",
          "required": [
            "workdays"
          ],
          "additionalProperties": false,
          "properties": {
            "workdays": {
              "$ref": "#/$defs/workdayAmount"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "workhours"
          ],
          "additionalProperties": false,
          "properties": {
            "workhours": {
              "$ref": "#/$defs/workhourAmount"
            }
          }
        }
      ]
    }
  }
}
